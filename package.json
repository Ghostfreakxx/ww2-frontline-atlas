    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pngjs": "^7.0.0",
