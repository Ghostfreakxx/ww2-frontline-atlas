  "private": true,
  "description": "iPad-controlled historical war-map presentation system for history podcasts (WWII Europe 1939–1945).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "geo:build": "node scripts/build-geo.mjs",
    "geo:relief": "node scripts/build-relief.mjs",
    "geo:control": "node scripts/build-control.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "next": "^16.4.0",
